# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Dashboard > Settings > API). Same project as AMC-Assistant. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for one thing: saving person details fetched on demand
# (kovarboxd.save_person_details). Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- TMDb ---
# "API Read Access Token" (v4). Server-only, for person details on demand.
TMDB_API_TOKEN=
