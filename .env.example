# Copy this file to .env and fill in real values. .env is gitignored.

# TMDb "API Read Access Token" (the long v4 token, not the short v3 API key).
# https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=your-tmdb-read-access-token

# Supabase Session pooler connection string (port 5432 on *.pooler.supabase.com).
# Supabase dashboard: Connect > Session pooler. Do not use the direct connection,
# it is IPv6 only and GitHub Actions runners cannot reach it.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
